---
import InteractiveMap from "../components/InteractiveMap.svelte";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Symnoesis (SYMN-01) — Research Initiative</title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.6;
        color: #0f172a;
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
      header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem 0;
      }
      p.subtitle {
        color: #475569;
        font-size: 1.125rem;
        margin: 0;
      }
      section {
        margin-bottom: 3rem;
      }
      h2 {
        font-size: 1.35rem;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 0.5rem;
      }
      footer {
        border-top: 1px solid #e2e8f0;
        padding-top: 1.5rem;
        color: #64748b;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Symnoesis (SYMN-01)</h1>
      <p class="subtitle">An open research initiative for the measurement of human–machine symbiosis.</p>
    </header>

    <main>
      <section>
        <h2>Interactive Map Portal</h2>
        <p>
          The 16×16 Gray-coded coordinate grid embeds the 4 human variables (columns) and 4 machine variables (rows).
          Select any pixel to inspect its coordinates and state properties.
        </p>
        <InteractiveMap client:load />
      </section>

      <section>
        <h2>Research & Evidence Integrity</h2>
        <p>
          All published findings carry strict evidence tiering (E0 specified, E1 synthetic, E2 empirical pilot, E3 peer-audited field).
          Every measurement record is cryptographically signed and independently verifiable.
        </p>
      </section>
    </main>

    <footer>
      <p>Symnoesis Research Initiative — Open Source under Apache-2.0 and CC BY 4.0.</p>
    </footer>
  </body>
</html>
