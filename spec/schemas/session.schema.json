{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "type": "object",
  "required": [
    "session_id",
    "dyad_id",
    "start_time",
    "turn_count"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "dyad_id": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "turn_count": {
      "type": "integer"
    }
  }
}