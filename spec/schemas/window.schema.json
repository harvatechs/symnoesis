{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window",
  "type": "object",
  "required": [
    "window_id",
    "dyad_id",
    "start_time",
    "end_time",
    "session_ids"
  ],
  "properties": {
    "window_id": {
      "type": "string"
    },
    "dyad_id": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}