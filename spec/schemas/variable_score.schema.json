{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VariableScore",
  "type": "object",
  "required": [
    "variable_id",
    "mu",
    "sigma",
    "p_binary"
  ],
  "properties": {
    "variable_id": {
      "type": "string",
      "enum": [
        "H1",
        "H2",
        "H3",
        "H4",
        "M1",
        "M2",
        "M3",
        "M4"
      ]
    },
    "mu": {
      "type": "number"
    },
    "sigma": {
      "type": "number"
    },
    "p_binary": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}